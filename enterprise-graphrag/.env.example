# Copy this file to .env and fill in your values
# cp .env.example .env

# Generator (all 3 pipelines) — Gemini 2.5 Flash
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Blind judge — OpenAI gpt-4o-mini (different model family from the generator)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o-mini

# Embedder (Pipeline 2 + Pipeline 3), 384-dim, cosine
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- TigerGraph Savanna (Pipeline 3: GraphRAG — both graph AND vector store) ---
# Create a workspace at https://tgcloud.io, then fill these in.
# HOST must include https:// and have no trailing path.
TIGERGRAPH_HOST=https://<your-id>.i.tgcloud.io
TIGERGRAPH_GRAPH=finance
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_SECRET=

# Fail-loud: Pipeline 3 aborts if the live TigerGraph is unreachable.
P3_REQUIRE_TG=1

# Fair-comparison context budget (Pipeline 2 + Pipeline 3, same for both)
CONTEXT_NUM_CHUNKS=10
CONTEXT_CHUNK_CHARS=2000
# gemini-2.5-flash draws THINKING and visible output from the SAME maxOutputTokens
# budget. At 512 the model spends ~489 on reasoning and emits ~11 visible tokens: the
# router's JSON plan truncates mid-string, P3 silently falls back to vector search, and
# the baseline returns empty answers. 8192 is the code default in config.py — do not
# lower it to save cost, it is not where the cost is.
MAX_TOKENS=8192

# ── SECRETS — never commit ────────────────────────────────────────────────────
# Credentials go on each machine by hand. mastergraph-round3/.env.example is the
# template; copy it to .env and fill it in. See _evidence/CONTEXT.md §2.
.env
*.env
!.env.example
!*.env.example

# ── The embedded git repo that broke `git add .` ──────────────────────────────
# mastergraph-round3 shipped with its own .git, so `git add .` staged it as a
# 160000 gitlink pointing at a commit that exists only on the original machine —
# every clone would get an EMPTY mastergraph-round3/. Renamed to .git-disabled so
# its files are tracked normally. Kept locally for provenance, never committed.
.git-disabled/
**/.git-disabled/

# ── TOO BIG FOR GITHUB (>100 MB is a hard reject) ─────────────────────────────
# All of these are REGENERATED, not authored. Rebuild instructions in CONTEXT.md §6.
#
#   chroma.sqlite3      822.6 MB   <- rebuild: python build/round3_tg_ingest.py / chroma_store
#   data_level0.bin      98.7 MB   <- same
#   corpus.jsonl        113.5 MB   <- rebuild: python build/build_round3_corpus.py
#   documents.jsonl      85.7 MB   <- same
#
# The RAW SEC filings in sp100_edgar_downloader/ ARE committed, so both the corpus
# and the Chroma index can be rebuilt from source on any machine.
mastergraph-round3/chroma_db_round3/
mastergraph-round3/datasets/round3/corpus.jsonl
mastergraph-round3/datasets/round3/documents.jsonl

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Logs and scratch ──────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db

# ── enterprise-graphrag REGENERABLES — too big for GitHub, all rebuildable ────
# GitHub hard-rejects >100 MB and warns over 50 MB. Every file below is produced by a
# script in build/, never hand-authored, so excluding them costs nothing but a rebuild.
#
#   corpus.jsonl        142 MB  ->  python build/build_enterprise_corpus.py
#                                   python build/add_directory_docs.py --push
#   documents.jsonl     119 MB  ->  same two commands (written together)
#   index/edges_prov     61 MB  ->  python build/build_edge_index.py
#   index_v2/edges_prov  56 MB  ->  python build/canonicalize.py
#
# The 20k source documents live in datasets/enterprise/raw/ (or are re-downloadable),
# and employee_directory.yaml IS committed — it is small and the org chart is the one
# thing the whole benchmark depends on.
enterprise-graphrag/datasets/enterprise/corpus.jsonl
enterprise-graphrag/datasets/enterprise/documents.jsonl
enterprise-graphrag/pipeline3_round3/index/edges_prov.json
enterprise-graphrag/pipeline3_round3/index_v2/edges_prov.json

# caches and scratch
**/__pycache__/
*.pyc
enterprise-graphrag/datasets/enterprise/corpus.jsonl.bak

# Data-transfer archives. These carry corpus.jsonl / documents.jsonl / edges_prov.json, each of
# which is ignored individually above for exceeding GitHub's 100 MB limit — so committing the
# tarball would push exactly the payload those rules exist to keep out. Moved between machines
# by Drive, not by git.
*.tar.gz
*.tgz
